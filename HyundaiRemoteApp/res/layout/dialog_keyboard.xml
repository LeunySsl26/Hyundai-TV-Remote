<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/card_bg">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⌨ Teclado y Búsqueda"
        android:textColor="@color/text_white"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_dialog_tip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Escribe aquí con el teclado de tu móvil para escribir en el televisor (YouTube, Netflix, Navegador, etc.):"
        android:textColor="@color/text_muted"
        android:textSize="12sp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/et_search_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:background="@drawable/card_bg"
        android:textColor="@color/text_white"
        android:textColorHint="@color/text_muted"
        android:hint="Escribe el texto a buscar..."
        android:padding="12dp"
        android:textSize="15sp"
        android:inputType="textCapSentences|textAutoCorrect"
        android:imeOptions="actionSearch" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="14dp">

        <Button
            android:id="@+id/btn_dialog_backspace"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/btn_remote"
            android:text="⌫ BORRAR"
            android:textColor="@color/text_white"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btn_dialog_clear"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/btn_remote"
            android:text="✕ LIMPIAR"
            android:textColor="@color/text_white"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp">

        <Button
            android:id="@+id/btn_dialog_send"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/btn_remote"
            android:text="ESCRIBIR EN TV"
            android:textColor="@color/text_white"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_dialog_enter"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/btn_accent"
            android:text="🔍 BUSCAR (ENTER)"
            android:textColor="@color/text_white"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
